<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ตารางฟิตหุ่นสุขภาพดี - ฉบับวัยรุ่น</title>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #0f0f0f;
            --card-bg: #1a1a1a;
            --primary: #ff1e38;
            --primary-hover: #d9142d;
            --text-main: #ffffff;
            --text-muted: #b0b0b0;
            --border-color: #333333;
        }

        body {
            font-family: 'Kanit', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .container {
            width: 100%;
            max-width: 850px;
            background-color: var(--card-bg);
            border: 2px solid var(--border-color);
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 15px 35px rgba(255, 30, 56, 0.15);
        }

        header {
            text-align: center;
            margin-bottom: 25px;
        }

        h1 {
            color: var(--primary);
            font-size: 28px;
            margin-bottom: 5px;
            font-weight: 700;
        }

        .subtitle {
            color: var(--text-muted);
            font-size: 14px;
        }

        /* ส่วนคำคมสร้างแรงบันดาลใจ */
        .quote-box {
            background-color: #000000;
            border-left: 4px solid var(--primary);
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .quote-text {
            font-size: 15px;
            color: #ffffff;
            margin: 0;
        }

        .btn-quote {
            background-color: var(--primary);
            color: white;
            border: none;
            padding: 8px 15px;
            border-radius: 6px;
            cursor: pointer;
            font-family: 'Kanit', sans-serif;
            font-size: 13px;
            transition: 0.2s;
        }

        .btn-quote:hover {
            background-color: var(--primary-hover);
        }

        /* แถบเลือกวัน */
        .day-tabs {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }

        .day-tab {
            background-color: #2b2b2b;
            color: var(--text-muted);
            border: 1px solid var(--border-color);
            padding: 10px 18px;
            border-radius: 10px;
            cursor: pointer;
            font-family: 'Kanit', sans-serif;
            font-size: 14px;
            font-weight: 500;
            white-space: nowrap;
            transition: all 0.2s;
        }

        .day-tab.active {
            background-color: var(--primary);
            color: white;
            border-color: var(--primary);
            box-shadow: 0 4px 12px rgba(255, 30, 56, 0.4);
        }

        .day-tab:hover:not(.active) {
            background-color: #383838;
            color: white;
        }

        /* เนื้อหาตารางรายวัน */
        .schedule-content {
            background-color: #121212;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 25px;
        }

        .schedule-content h2 {
            margin-top: 0;
            color: var(--primary);
            font-size: 20px;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 10px;
        }

        .section-title {
            font-weight: 600;
            color: #ffffff;
            margin-top: 15px;
            margin-bottom: 5px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        ul {
            margin: 0;
            padding-left: 20px;
            color: var(--text-muted);
        }

        li {
            margin-bottom: 6px;
            font-size: 14px;
        }

        /* เช็คลิสต์กิจกรรมประจำวัน */
        .tracker-box {
            background-color: #1a1a1a;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 20px;
        }

        .tracker-title {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 12px;
            color: #ffffff;
        }

        .checkbox-group {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 12px;
        }

        .checkbox-item {
            display: flex;
            align-items: center;
            gap: 10px;
            background-color: #262626;
            padding: 10px 15px;
            border-radius: 8px;
            cursor: pointer;
            border: 1px solid transparent;
            transition: 0.2s;
        }

        .checkbox-item:hover {
            border-color: var(--primary);
        }

        .checkbox-item input {
            accent-color: var(--primary);
            width: 18px;
            height: 18px;
            cursor: pointer;
        }

        .checkbox-item span {
            font-size: 13px;
            color: #dddddd;
        }

        @media (max-width: 600px) {
            .container {
                padding: 15px;
            }
            h1 {
                font-size: 22px;
            }
        }
    </style>
</head>
<body>

    <div class="container">
        <header>
            <h1>🔥 ตารางปั้นหุ่นสวย สุขภาพดี 🔥</h1>
            <p class="subtitle">สำหรับเด็กอายุ 14-15 ปี (สูง 178 ซม. / น้ำหนัก 80 กก.) • ทำได้ที่บ้าน ไม่หักโหม</p>
        </header>

        <!-- กล่องคำคม -->
        <div class="quote-box">
            <p class="quote-text" id="quoteDisplay">"ความพยายามไม่เคยทำร้ายใคร ค่อยๆ ทำทีละนิดเพื่อตัวเราเองนะ!"</p>
            <button class="btn-quote" onclick="changeQuote()">สุ่มคำคม</button>
        </div>

        <!-- ปุ่มกดเลือกวัน -->
        <div class="day-tabs">
            <button class="day-tab active" onclick="selectDay('mon', this)">จันทร์</button>
            <button class="day-tab" onclick="selectDay('tue', this)">อังคาร</button>
            <button class="day-tab" onclick="selectDay('wed', this)">พุธ</button>
            <button class="day-tab" onclick="selectDay('thu', this)">พฤหัสบดี</button>
            <button class="day-tab" onclick="selectDay('fri', this)">ศุกร์</button>
            <button class="day-tab" onclick="selectDay('sat', this)">เสาร์</button>
            <button class="day-tab" onclick="selectDay('sun', this)">อาทิตย์</button>
        </div>

        <!-- แสดงเนื้อหาตามวัน -->
        <div class="schedule-content" id="scheduleArea">
            <!-- ข้อมูลเริ่มต้น (วันจันทร์) -->
            <h2>📅 วันจันทร์: เริ่มต้นสัปดาห์ด้วยความสดใส</h2>
            <div class="section-title">⚡ กิจกรรมการออกกำลังกาย</div>
            <ul>
                <li>Warm-up ยืดเหยียดกล้ามเนื้อ (5 นาที)</li>
                <li>Cardio: กระโดดตบ / สควอท ท่าละ 45 วินาที พัก 15 วินาที ทำวน 3 รอบ (15 นาที)</li>
                <li>Core: แพงค์ค้างไว้ 30 วินาที จำนวน 3 เซต (10 นาที)</li>
                <li>Cool-down ยืดคลายกล้ามเนื้อ (5 นาที)</li>
            </ul>
            <div class="section-title">🥗 แนวทางการกินอาหาร</div>
            <ul>
                <li><b>มื้อเช้า:</b> ข้าวต้มหมูสับ หรือไข่กระทะ + นมจืด</li>
                <li><b>มื้อกลางวัน:</b> ข้าวราดแกง (เน้นผัดผัก ไก่ หรือปลา ไม่ทอด)</li>
                <li><b>มื้อเย็น:</b> เกี๊ยวน้ำ หรือสลัดอกไก่ + ผลไม้สด</li>
            </ul>
        </div>

        <!-- เช็คลิสต์ภารกิจประจำวัน -->
        <div class="tracker-box">
            <div class="tracker-title">✨ เช็คลิสต์พิชิตเป้าหมายวันนี้</div>
            <div class="checkbox-group">
                <label class="checkbox-item">
                    <input type="checkbox">
                    <span>ดื่มน้ำเปล่าครบ 1.5 - 2 ลิตร</span>
                </label>
                <label class="checkbox-item">
                    <input type="checkbox">
                    <span>ออกกำลังกายตามตารางครบถ้วน</span>
                </label>
                <label class="checkbox-item">
                    <input type="checkbox">
                    <span>งดน้ำหวานและขนมกรุบกรอบ</span>
                </label>
                <label class="checkbox-item">
                    <input type="checkbox">
                    <span>นอนหลับพักผ่อนเกิน 8 ชั่วโมง</span>
                </label>
            </div>
        </div>
    </div>

    <script>
        const scheduleData = {
            mon: {
                title: "📅 วันจันทร์: เริ่มต้นสัปดาห์ด้วยความสดใส",
                workout: [
                    "Warm-up ยืดเหยียดกล้ามเนื้อ (5 นาที)",
                    "Cardio: กระโดดตบ / สควอท ท่าละ 45 วินาที พัก 15 วินาที ทำวน 3 รอบ (15 นาที)",
                    "Core: แพงค์ค้างไว้ 30 วินาที จำนวน 3 เซต (10 นาที)",
                    "Cool-down ยืดคลายกล้ามเนื้อ (5 นาที)"
                ],
                diet: [
                    "<b>มื้อเช้า:</b> ข้าวต้มหมูสับ หรือไข่กระทะ + นมจืด",
                    "<b>มื้อกลางวัน:</b> ข้าวราดแกง (เน้นผัดผัก ไก่ หรือปลา ไม่ทอด)",
                    "<b>มื้อเย็น:</b> เกี๊ยวน้ำ หรือสลัดอกไก่ + ผลไม้สด"
                ]
            },
            tue: {
                title: "📅 วันอังคาร: วันพักผ่อนสบายๆ",
                workout: [
                    "พักผ่อนจากการออกกำลังกายหนัก",
                    "พาสุนัขเดินเล่น หรือทำงานบ้านเบาๆ (กวาดบ้าน ถูบ้าน) 15-20 นาที"
                ],
                diet: [
                    "<b>มื้อเช้า:</b> แซนด์วิชโฮลวีตไข่ดาว + น้ำเต้าหู้ (หวานน้อย)",
                    "<b>มื้อกลางวัน:</b> ข้าวกล้องกับปลาทอด/นึ่ง + แกงจืด",
                    "<b>มื้อเย็น:</b> ยำอกไก่ย่าง หรือส้มตำไทย (ไม่ใส่ชูรสและไม่หวานจัด)"
                ]
            },
            wed: {
                title: "📅 วันพุธ: เคลื่อนไหวร่างกายกลางสัปดาห์",
                workout: [
                    "Warm-up ยืดเหยียด (5 นาที)",
                    "Cardio: ทำท่าบอดี้เวทเบาๆ ต่อเนื่อง เช่น ลุกนั่ง สลับก้าวขา (20 นาที)",
                    "Cool-down ยืดกล้ามเนื้อหลังออกกำลังกาย (5 นาที)"
                ],
                diet: [
                    "<b>มื้อเช้า:</b> โจ๊กหมูใส่ไข่ + นมเปรี้ยวสูตรน้ำตาลน้อย",
                    "<b>มื้อกลางวัน:</b> ข้าวผัดหมูหรือไก่ (ใส่ผักเยอะๆ)",
                    "<b>มื้อเย็น:</b> ต้มยำน้ำใส + ข้าวสวยครึ่งทัพพี"
                ]
            },
            thu: {
                title: "📅 วันพฤหัสบดี: วันเบาๆ เน้นขยับตัว",
                workout: [
                    "พักผ่อน / เดินเล่นรอบบ้าน หรือยืดเหยียดผ่อนคลายกล้ามเนื้อ (15-20 นาที)"
                ],
                diet: [
                    "<b>มื้อเช้า:</b> ข้าวสวย + ไข่เจียวอบหม้อทอดไร้น้ำมัน + ผักบุ้งไฟแดง",
                    "<b>มื้อกลางวัน:</b> บะหมี่น้ำใส (ปรุงรสน้อย)",
                    "<b>มื้อเย็น:</b> นมจืด 1 แก้ว + ขนมปังโฮลวีตทาเนยถั่ว"
                ]
            },
            fri: {
                title: "📅 วันศุกร์: โค้งสุดท้ายก่อนวันหยุด",
                workout: [
                    "Warm-up (5 นาที)",
                    "Cardio & Core: สลับท่าสควอท แพงค์ และวิ่งยกเข่าสูงอยู่กับที่ (25 นาที)",
                    "Cool-down ยืดเหยียดกล้ามเนื้อ (5 นาที)"
                ],
                diet: [
                    "<b>มื้อเช้า:</b> ข้าวต้มปลา หรือซีเรียลโฮลกรีนกับนมจืด",
                    "<b>มื้อกลางวัน:</b> ข้าวกะเพราอกไก่ (สั่งน้ำมันน้อย / ไม่หวาน)",
                    "<b>มื้อเย็น:</b> แกงเลียงกุ้งสด + ข้าวสวย"
                ]
            },
            sat: {
                title: "📅 วันเสาร์: เคลื่อนไหวสนุกๆ ตามใจชอบ",
                workout: [
                    "กิจกรรมสนุกๆ: เปิดคลิปเต้นตามเพลงที่ชอบ หรือทำความสะอาดห้องครั้งใหญ่ (30 นาที)"
                ],
                diet: [
                    "<b>มื้อเช้า:</b> ข้าวเหนียวหมูปิ้ง (เลือกเนื้อไม่ติดมัน) หรือไข่ต้ม 2 ฟอง",
                    "<b>มื้อกลางวัน:</b> ข้าวหน้าไก่ย่าง (ไม่เอาหนัง)",
                    "<b>มื้อเย็น:</b> สลัดโรลปูอัด/อกไก่ + น้ำเปล่า"
                ]
            },
            sun: {
                title: "📅 วันอาทิตย์: ชาร์จพลังเต็มที่เพื่อสัปดาห์ใหม่",
                workout: [
                    "พักผ่อนเต็มที่ นอนหลับพักผ่อนให้เพียงพอ"
                ],
                diet: [
                    "<b>มื้อเช้า:</b> แพนเค้กกล้วยหอมทำเอง (แป้งโฮลวีต) + นมสด",
                    "<b>มื้อกลางวัน:</b> สุกี้แห้งทะเลหรือไก่ (ใส่ผักเยอะๆ)",
                    "<b>มื้อเย็น:</b> ปลานึ่งซีอิ๊ว + ผักลวก"
                ]
            }
        };

        const quotes = [
            "\"ความพยายามไม่เคยทำร้ายใคร ค่อยๆ ทำทีละนิดเพื่อตัวเราเองนะ!\"",
            "\"ไม่ได้แข่งกับใคร แข่งกับตัวเองเมื่อวานนี้ก็พอ!\"",
            "\"สุขภาพที่ดีเริ่มต้นจากการลงมือทำตั้งแต่วันนี้ สู้ๆ!\"",
            "\"หุ่นในฝันไม่ได้มาจากการรอคอย แต่มาจากการลงมือทำ!\"",
            "\"เหนื่อยได้ พักได้ แต่ห้ามถอดใจเด็ดขาด!\""
        ];

        function selectDay(dayKey, element) {
            // เปลี่ยนสถานะปุ่มแอคทีฟ
            document.querySelectorAll('.day-tab').forEach(tab => tab.classList.remove('active'));
            element.classList.add('active');

            // ดึงข้อมูลตามวันที่กด
            const data = scheduleData[dayKey];
            const area = document.getElementById('scheduleArea');

            let workoutHtml = data.workout.map(item => `<li>${item}</li>`).join('');
            let dietHtml = data.diet.map(item => `<li>${item}</li>`).join('');

            area.innerHTML = `
                <h2>${data.title}</h2>
                <div class="section-title">⚡ กิจกรรมการออกกำลังกาย</div>
                <ul>${workoutHtml}</ul>
                <div class="section-title">🥗 แนวทางการกินอาหาร</div>
                <ul>${dietHtml}</ul>
            `;
        }

        function changeQuote() {
            const randomQuote = quotes[Math.floor(Math.random() * quotes.length)];
            document.getElementById('quoteDisplay').innerText = randomQuote;
        }
    </script>

</body>
</html>
